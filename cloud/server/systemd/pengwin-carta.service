[Unit]
Description=Pengwin - esiti del Goal/No Goal su carta da Betfair e dai risultati (nessun denaro, chiave Delayed)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pengwin
WorkingDirectory=/home/pengwin/pengwin/cloud
Environment=TZ=Europe/Rome
ExecStart=/home/pengwin/venv/bin/python -m src.reale.carta_btts --contabilizza
TimeoutStartSec=300
