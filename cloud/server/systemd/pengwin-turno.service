[Unit]
Description=Pengwin - turno automatico con soldi veri (betfair.it) e Goal/No Goal su carta
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pengwin
WorkingDirectory=/home/pengwin/pengwin/cloud
Environment=TZ=Europe/Rome
# Live App Key per il turno reale; il Goal/No Goal su carta torna da solo alla
# Delayed di betfair.env (src/reale/automatico.py). Gioca solo se l'interruttore
# config_reale.attivo e' acceso dalla pagina privata.
EnvironmentFile=-/home/pengwin/.betfair/live.env
ExecStart=/home/pengwin/venv/bin/python -m src.reale.automatico
TimeoutStartSec=1200
